{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alba project configuration",
  "type": "object",
  "required": ["id", "name", "root", "work_orders", "state_dir"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "minLength": 1 },
    "work_orders": { "type": "string", "minLength": 1 },
    "state_dir": { "type": "string", "minLength": 1 },
    "state": {
      "type": "object",
      "properties": {
        "backend": { "type": "string", "enum": ["sqlite", "files"] }
      },
      "additionalProperties": false
    },
    "split": {
      "type": "object", "required": ["approve"], "additionalProperties": false,
      "properties": { "approve": { "oneOf": [{ "enum": ["auto", "manual"] }, { "type": "object", "additionalProperties": { "enum": ["auto", "manual"] } }] } }
    },
    "phases": {
      "description": "Order kinds mapped to one or more read-only phases followed by one final write phase. Phase ids are unique within each kind.",
      "type": "object",
      "additionalProperties": {
        "type": "array", "minItems": 2, "uniqueItems": true,
        "contains": { "properties": { "mode": { "const": "write" } } }, "minContains": 1, "maxContains": 1,
        "items": {
          "type": "object", "required": ["id", "mode"], "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "mode": { "enum": ["read-only", "split", "write"] },
            "role": { "type": "string", "minLength": 1 },
            "timeout_minutes": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "tag"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "order": { "type": "string", "minLength": 1 },
          "tag": { "type": "string", "minLength": 1 },
          "every_minutes": { "type": "integer", "minimum": 15 },
          "daily_at": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "cron": { "type": "string", "minLength": 9 },
          "precheck": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "minItems": 1, "items": { "type": "string" } }
            ]
          },
          "catch_up": {
            "type": "string",
            "enum": ["latest", "none"],
            "default": "latest"
          },
          "max_open": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "worker": { "type": "string", "minLength": 1 },
          "priority": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "needs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "oneOf": [
          { "required": ["every_minutes"] },
          { "required": ["daily_at"] },
          { "required": ["cron"] }
        ],
        "additionalProperties": false
      }
    },
    "consult": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "role": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "default": "consultant"
        },
        "max_per_run": { "type": "integer", "minimum": 1, "default": 3 },
        "timeout_minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30,
          "default": 10
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }
        }
      },
      "additionalProperties": false
    }
  }
}
